          "attributes": {
            "id": "da893495c4521f4228df91c10c2a1e39",
            "json": "{\n  \"_ruleFormat_\": \"rules_v2026_06_09\",\n  \"rules\": {\n    \"behaviors\": [\n      {\n        \"name\": \"origin\",\n        \"options\": {\n          \"cacheKeyHostname\": \"ORIGIN_HOSTNAME\",\n          \"compress\": true,\n          \"customValidCnValues\": [\n            \"{{Origin Hostname}}\",\n            \"{{Forward Host Header}}\"\n          ],\n          \"enableTrueClientIp\": false,\n          \"forwardHostHeader\": \"ORIGIN_HOSTNAME\",\n          \"hostname\": \"lalexand-amd-terra-dev.akamaized.net\",\n          \"http2Enabled\": false,\n          \"http2Title\": \"\",\n          \"httpPort\": 443,\n          \"httpsPort\": 443,\n          \"ipVersion\": \"IPV4\",\n          \"minTlsVersion\": \"DYNAMIC\",\n          \"originCertificate\": \"\",\n          \"originCertsToHonor\": \"STANDARD_CERTIFICATE_AUTHORITIES\",\n          \"originSni\": true,\n          \"originType\": \"CUSTOMER\",\n          \"ports\": \"\",\n          \"standardCertificateAuthorities\": [\n            \"akamai-permissive\"\n          ],\n          \"tlsVersionTitle\": \"\",\n          \"verificationMode\": \"CUSTOM\"\n        }\n      },\n      {\n        \"name\": \"cpCode\",\n        \"options\": {\n          \"enableDefaultContentProviderCode\": false,\n          \"value\": {\n            \"createdDate\": 1726066265000,\n            \"description\": \"lalexand-amd\",\n            \"id\": 1698638,\n            \"name\": \"lalexand-amd\",\n            \"products\": [\n              \"Adaptive_Media_Delivery\"\n            ]\n          }\n        }\n      },\n      {\n        \"name\": \"segmentedMediaOptimization\",\n        \"options\": {\n          \"behavior\": \"LIVE\",\n          \"enableUllStreaming\": false,\n          \"showAdvanced\": false\n        }\n      },\n      {\n        \"name\": \"originCharacteristics\",\n        \"options\": {\n          \"authenticationMethod\": \"AUTOMATIC\",\n          \"authenticationMethodTitle\": \"\",\n          \"country\": \"US_EAST\",\n          \"originLocationTitle\": \"\"\n        }\n      },\n      {\n        \"name\": \"contentCharacteristicsAMD\",\n        \"options\": {\n          \"catalogSize\": \"UNKNOWN\",\n          \"contentType\": \"HD\",\n          \"dash\": true,\n          \"hds\": false,\n          \"hls\": true,\n          \"popularityDistribution\": \"UNKNOWN\",\n          \"segmentDurationDASH\": \"SEGMENT_DURATION_4S\",\n          \"segmentDurationHLS\": \"SEGMENT_DURATION_4S\",\n          \"segmentSizeDASH\": \"UNKNOWN\",\n          \"segmentSizeHLS\": \"UNKNOWN\",\n          \"smooth\": false\n        }\n      },\n      {\n        \"name\": \"clientCharacteristics\",\n        \"options\": {\n          \"country\": \"GLOBAL_US_CENTRIC\"\n        }\n      },\n      {\n        \"name\": \"cacheKeyQueryParams\",\n        \"options\": {\n          \"behavior\": \"INCLUDE\",\n          \"exactMatch\": false,\n          \"parameters\": [\n            \"_HLS\",\n            \"max_segments\"\n          ]\n        }\n      },\n      {\n        \"name\": \"autoDomainValidation\",\n        \"options\": {\n          \"autodv\": \"\"\n        }\n      },\n      {\n        \"name\": \"modifyOutgoingRequestHeader\",\n        \"options\": {\n          \"action\": \"MODIFY\",\n          \"avoidDuplicateHeaders\": true,\n          \"customHeaderName\": \"Live-Key\",\n          \"newHeaderValue\": \"{{user.PMUSER_LIVE_KEY}}\",\n          \"standardModifyHeaderName\": \"OTHER\"\n        }\n      },\n      {\n        \"name\": \"allowTransferEncoding\",\n        \"options\": {\n          \"enabled\": true\n        }\n      },\n      {\n        \"name\": \"http2\",\n        \"options\": {\n          \"enabled\": \"\"\n        }\n      },\n      {\n        \"name\": \"globalRequestNumber\",\n        \"options\": {\n          \"headerName\": \"Akamai-GRN\",\n          \"outputOption\": \"RESPONSE_HEADER\"\n        }\n      },\n      {\n        \"name\": \"breadcrumbs\",\n        \"options\": {\n          \"enabled\": true,\n          \"loggingEnabled\": true,\n          \"optMode\": false\n        }\n      }\n    ],\n    \"children\": [\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"setVariable\",\n            \"options\": {\n              \"extractLocation\": \"QUERY_STRING\",\n              \"queryParameterName\": \"r\",\n              \"transform\": \"URL_DECODE\",\n              \"valueSource\": \"EXTRACT\",\n              \"variableName\": \"PMUSER_REGION\"\n            }\n          }\n        ],\n        \"criteria\": [\n          {\n            \"name\": \"queryStringParameter\",\n            \"options\": {\n              \"matchCaseSensitiveName\": true,\n              \"matchOperator\": \"EXISTS\",\n              \"matchWildcardName\": false,\n              \"parameterName\": \"r\"\n            }\n          }\n        ],\n        \"name\": \"Extract r parameter\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"origin\",\n            \"options\": {\n              \"cacheKeyHostname\": \"ORIGIN_HOSTNAME\",\n              \"compress\": true,\n              \"customValidCnValues\": [\n                \"{{Origin Hostname}}\",\n                \"{{Forward Host Header}}\"\n              ],\n              \"enableTrueClientIp\": false,\n              \"forwardHostHeader\": \"ORIGIN_HOSTNAME\",\n              \"hostname\": \"prod.example.com\",\n              \"http2Enabled\": false,\n              \"http2Title\": \"\",\n              \"httpPort\": 80,\n              \"httpsPort\": 443,\n              \"ipVersion\": \"IPV4\",\n              \"minTlsVersion\": \"DYNAMIC\",\n              \"originCertificate\": \"\",\n              \"originCertsToHonor\": \"STANDARD_CERTIFICATE_AUTHORITIES\",\n              \"originSni\": true,\n              \"originType\": \"CUSTOMER\",\n              \"ports\": \"\",\n              \"standardCertificateAuthorities\": [\n                \"akamai-permissive\"\n              ],\n              \"tlsVersionTitle\": \"\",\n              \"verificationMode\": \"CUSTOM\"\n            }\n          },\n          {\n            \"name\": \"setVariable\",\n            \"options\": {\n              \"transform\": \"NONE\",\n              \"valueSource\": \"EXPRESSION\",\n              \"variableName\": \"PMUSER_EU\",\n              \"variableValue\": \"true\"\n            }\n          }\n        ],\n        \"criteria\": [\n          {\n            \"name\": \"matchVariable\",\n            \"options\": {\n              \"matchCaseSensitive\": true,\n              \"matchOperator\": \"IS_ONE_OF\",\n              \"matchWildcard\": false,\n              \"variableName\": \"PMUSER_REGION\",\n              \"variableValues\": [\n                \"ZXU=\"\n              ]\n            }\n          }\n        ],\n        \"name\": \"EU Origin\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"children\": [\n          {\n            \"behaviors\": [\n              {\n                \"name\": \"datastream\",\n                \"options\": {\n                  \"logEnabled\": false,\n                  \"logStreamTitle\": \"\",\n                  \"streamType\": \"LOG\"\n                }\n              }\n            ],\n            \"name\": \"DataStream for GCS\",\n            \"options\": {},\n            \"criteriaMustSatisfy\": \"all\"\n          },\n          {\n            \"behaviors\": [\n              {\n                \"name\": \"setVariable\",\n                \"options\": {\n                  \"generator\": \"RAND\",\n                  \"maxRandomNumber\": 100,\n                  \"minRandomNumber\": 1,\n                  \"transform\": \"NONE\",\n                  \"valueSource\": \"GENERATE\",\n                  \"variableName\": \"PMUSER_RANDOM_VARIABLE\"\n                }\n              }\n            ],\n            \"name\": \"DataStream for TrafficPeak Random variable\",\n            \"options\": {},\n            \"criteriaMustSatisfy\": \"all\"\n          },\n          {\n            \"behaviors\": [\n              {\n                \"name\": \"datastream\",\n                \"options\": {\n                  \"logEnabled\": false,\n                  \"logStreamTitle\": \"\",\n                  \"streamType\": \"LOG\"\n                }\n              }\n            ],\n            \"criteria\": [\n              {\n                \"name\": \"matchVariable\",\n                \"options\": {\n                  \"matchOperator\": \"IS_LESS_THAN_OR_EQUAL_TO\",\n                  \"variableExpression\": \"20\",\n                  \"variableName\": \"PMUSER_RANDOM_VARIABLE\"\n                }\n              }\n            ],\n            \"name\": \"DataStream for TrafficPeak\",\n            \"options\": {},\n            \"criteriaMustSatisfy\": \"all\"\n          }\n        ],\n        \"name\": \"DataStream\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"modifyOutgoingResponseHeader\",\n            \"options\": {\n              \"action\": \"MODIFY\",\n              \"avoidDuplicateHeaders\": true,\n              \"newHeaderValue\": \"https://vimeo.com\",\n              \"standardModifyHeaderName\": \"ACCESS_CONTROL_ALLOW_ORIGIN\"\n            }\n          },\n          {\n            \"name\": \"modifyOutgoingResponseHeader\",\n            \"options\": {\n              \"action\": \"MODIFY\",\n              \"avoidDuplicateHeaders\": true,\n              \"newHeaderValue\": \"GET,POST,OPTIONS\",\n              \"standardModifyHeaderName\": \"ACCESS_CONTROL_ALLOW_METHODS\"\n            }\n          },\n          {\n            \"name\": \"modifyOutgoingResponseHeader\",\n            \"options\": {\n              \"action\": \"MODIFY\",\n              \"avoidDuplicateHeaders\": true,\n              \"newHeaderValue\": \"origin,range,hdntl,hdnts,CMCD-Request,CMCD-Object,CMCD-Status,CMCD-Session,X-OTT-Agent\",\n              \"standardModifyHeaderName\": \"ACCESS_CONTROL_ALLOW_HEADERS\"\n            }\n          },\n          {\n            \"name\": \"modifyOutgoingResponseHeader\",\n            \"options\": {\n              \"action\": \"MODIFY\",\n              \"avoidDuplicateHeaders\": true,\n              \"newHeaderValue\": \"Server,range,hdntl,hdnts,Akamai-Mon-Iucid-Ing,Akamai-Mon-Iucid-Del,Akamai-Request-BC,Akamai-GRN\",\n              \"standardModifyHeaderName\": \"ACCESS_CONTROL_EXPOSE_HEADERS\"\n            }\n          },\n          {\n            \"name\": \"modifyOutgoingResponseHeader\",\n            \"options\": {\n              \"action\": \"MODIFY\",\n              \"avoidDuplicateHeaders\": true,\n              \"newHeaderValue\": \"true\",\n              \"standardModifyHeaderName\": \"ACCESS_CONTROL_ALLOW_CREDENTIALS\"\n            }\n          },\n          {\n            \"name\": \"modifyOutgoingResponseHeader\",\n            \"options\": {\n              \"action\": \"MODIFY\",\n              \"avoidDuplicateHeaders\": true,\n              \"newHeaderValue\": \"86400\",\n              \"standardModifyHeaderName\": \"ACCESS_CONTROL_MAX_AGE\"\n            }\n          }\n        ],\n        \"name\": \"Default CORS Policy\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"setVariable\",\n            \"options\": {\n              \"extractLocation\": \"CLIENT_REQUEST_HEADER\",\n              \"headerName\": \"Origin\",\n              \"transform\": \"NONE\",\n              \"valueSource\": \"EXTRACT\",\n              \"variableName\": \"PMUSER_ORIGIN\"\n            }\n          },\n          {\n            \"name\": \"modifyOutgoingResponseHeader\",\n            \"options\": {\n              \"action\": \"MODIFY\",\n              \"avoidDuplicateHeaders\": true,\n              \"newHeaderValue\": \"{{user.PMUSER_ORIGIN}}\",\n              \"standardModifyHeaderName\": \"ACCESS_CONTROL_ALLOW_ORIGIN\"\n            }\n          }\n        ],\n        \"criteria\": [\n          {\n            \"name\": \"requestHeader\",\n            \"options\": {\n              \"headerName\": \"Origin\",\n              \"matchCaseSensitiveValue\": true,\n              \"matchOperator\": \"IS_ONE_OF\",\n              \"matchWildcardName\": false,\n              \"matchWildcardValue\": true,\n              \"values\": [\n                \"https://player.vimeo.com\",\n                \"https://vimeo.com\",\n                \"https://*.vimeows.com\",\n                \"http://embed.vhx.tv\",\n                \"https://embed.vhx.tv\",\n                \"http://embed.vhxqa1.com\",\n                \"https://embed.vhxqa1.com\",\n                \"http://embed.vhxqa2.com\",\n                \"https://embed.vhxqa2.com\",\n                \"http://embed.vhxqa3.com\",\n                \"https://embed.vhxqa3.com\",\n                \"http://embed.vhxqa4.com\",\n                \"https://embed.vhxqa4.com\",\n                \"http://embed.vhxqa5.com\",\n                \"https://embed.vhxqa5.com\",\n                \"http://embed.vhxqa6.com\",\n                \"https://embed.vhxqa6.com\",\n                \"http://embed.vhxqa7.com\",\n                \"https://embed.vhxqa7.com\",\n                \"http://embed.vhxqa8.com\",\n                \"https://embed.vhxqa8.com\",\n                \"http://embed.crystal.local\",\n                \"https://embed.crystal.local\",\n                \"https://embed.daveyeu.com\",\n                \"https://embed.criterionchannel.com\",\n                \"https://*.vimeo.work\",\n                \"https://embed.vhxstaging.com\"\n              ]\n            }\n          }\n        ],\n        \"name\": \"Vimeo CORS Policy\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"customBehavior\",\n            \"options\": {\n              \"behaviorId\": \"cbe_688680797\"\n            }\n          }\n        ],\n        \"criteria\": [\n          {\n            \"name\": \"path\",\n            \"options\": {\n              \"matchCaseSensitive\": false,\n              \"matchOperator\": \"DOES_NOT_MATCH_ONE_OF\",\n              \"normalize\": false,\n              \"values\": [\n                \"/.well-known/acme-challenge/*\"\n              ]\n            }\n          }\n        ],\n        \"name\": \"Token Auth\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"caching\",\n            \"options\": {\n              \"behavior\": \"CACHE_CONTROL_AND_EXPIRES\",\n              \"cacheControlDirectives\": \"\",\n              \"defaultTtl\": \"120s\",\n              \"enhancedRfcSupport\": false,\n              \"honorMustRevalidate\": true,\n              \"honorPrivate\": true,\n              \"mustRevalidate\": false\n            }\n          }\n        ],\n        \"name\": \"Caching\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"denyAccess\",\n            \"options\": {\n              \"enabled\": true,\n              \"reason\": \"default-deny-reason\"\n            }\n          }\n        ],\n        \"criteria\": [\n          {\n            \"name\": \"userLocation\",\n            \"options\": {\n              \"checkIps\": \"CONNECTING\",\n              \"countryValues\": [\n                \"CN\"\n              ],\n              \"field\": \"COUNTRY\",\n              \"matchOperator\": \"IS_ONE_OF\"\n            }\n          }\n        ],\n        \"name\": \"Deny China\",\n        \"options\": {},\n        \"criteriaMustSatisfy\": \"all\"\n      },\n      {\n        \"behaviors\": [\n          {\n            \"name\": \"denyAccess\",\n            \"options\": {\n              \"enabled\": true,\n              \"reason\": \"deny\"\n            }\n          }\n        ],\n        \"comments\": \"DMCA :\\tF-CS-10283834\\r\\nDMCA:  F-CS-10306830 /*/7725b1ca-1270-43b1-86cc-297116932455/avc/540p/*\\r\\ndmca: F-CS-10379307\\r\\ndmca: F-CS-10380623\\r\\nDMCA: F-CS-10405009 /*/313aa35f-20b2-46b9-929b-7e8ba69b15a8_fmp4/avc/360p/*\\r\\nDMCA: F-CS-10405024 /*/81750a68-144c-4852-b033-ae3035ac96c7_fmp4/avc/360p/*\\r\\nDMCA =: F-CS-10434667 -\\u003e/*/52571699-5138-48f9-a0aa-dcafe41bc25d_fmp4/avc/720p/* \\r\\nDMCA F-CS-10481410 /*/88cbf043-272f-4b02-9b5c-b2235bfcbafc/avc/360p/*\\r\\nDMCA F-CS-10481470 /*/0f82e0c0-f3fa-4c8b-8257-6c6ba7d32efb_fmp4/avc/540p/*\\r\\nDMCA F-CS-10506523 /*/f7eb31a9-3bfe-49db-91fe-a03da5a56509/avc/540p/* \\r\\n\\r\\n  \\r\\n\",\n        \"criteria\": [\n          {\n            \"name\": \"userLocation\",\n            \"options\": {\n              \"checkIps\": \"CONNECTING\",\n              \"countryValues\": [\n                \"ES\"\n              ],\n              \"field\": \"COUNTRY\",\n              \"matchOperator\": \"IS_ONE_OF\"\n            }\n          },\n          {\n            \"name\": \"hostname\",\n            \"options\": {\n              \"matchOperator\": \"IS_ONE_OF\",\n              \"values\": [\n                \"live-ak.vimeocdn.com\"\n              ]\n            }\n          },\n          {\n            \"name\": \"path\",\n            \"options\": {\n              \"matchCaseSensitive\": false,\n              \"matchOperator\": \"MATCHES_ONE_OF\",\n              \"normalize\": false,\n              \"values\": [\n                \"/*/4eb4afea-7917-4d32-a66f-b68546b1d2c1/*\",\n                \"/*/7725b1ca-1270-43b1-86cc-297116932455/avc/540p/*\",\n                \"/*/4a173eca-37a6-411d-a66b-705a2263